{
  "name": "jev-codex-cua",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Experimental Codex Sky desktop tools: native MCP for Claude Code, plus pi native/optional Jev modes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LonelyFellas/jev-codex-cua.git"
  },
  "homepage": "https://github.com/LonelyFellas/jev-codex-cua#readme",
  "bugs": {
    "url": "https://github.com/LonelyFellas/jev-codex-cua/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "deskhand-mcp": "./dist/mcp/cli.js"
  },
  "files": [
    "dist",
    "src",
    "skill",
    "skills",
    "fixtures",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_LICENSES.md",
    "!**/*.access.json*"
  ],
  "keywords": [
    "pi-package",
    "computer-use",
    "jev",
    "codex"
  ],
  "pi": {
    "extensions": [
      "./src/pi-extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test && npm run test:package",
    "test:package": "node --experimental-strip-types scripts/check-package.ts",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "accept:handoff": "node --experimental-strip-types scripts/accept-handoff.ts",
    "accept:app-access": "node --experimental-strip-types scripts/accept-app-access.ts",
    "allow-app": "node --experimental-strip-types src/add-app.ts",
    "app-access": "node dist/app-access.js",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.tools.json",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "eval": "npm run build && node dist/eval.js",
    "install-skill": "npm run build && node dist/install-skill.js",
    "uninstall-skill": "npm run build && node dist/install-skill.js --uninstall"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typebox": "^1.3.7"
  }
}
