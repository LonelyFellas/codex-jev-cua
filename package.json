{
  "name": "jev-codex-cua",
  "version": "0.3.2",
  "license": "MIT",
  "description": "Experimental pi desktop tools: native Codex Sky or optional Jev decisions",
  "repository": { "type": "git", "url": "git+https://github.com/LonelyFellas/jev-codex-cua.git" },
  "homepage": "https://github.com/LonelyFellas/jev-codex-cua#readme",
  "bugs": { "url": "https://github.com/LonelyFellas/jev-codex-cua/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "skill", "skills", "fixtures", "docs", "README.md", "README.zh-CN.md", "LICENSE", "NOTICE.md", "THIRD_PARTY_LICENSES.md", "!**/*.access.json*"],
  "keywords": ["pi-package", "computer-use", "jev", "codex"],
  "pi": { "extensions": ["./src/pi-extension.ts"], "skills": ["./skills"] },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test && npm run test:package",
    "test:package": "node --experimental-strip-types scripts/check-package.ts",
    "accept:handoff": "node --experimental-strip-types scripts/accept-handoff.ts",
    "accept:app-access": "node --experimental-strip-types scripts/accept-app-access.ts",
    "allow-app": "node --experimental-strip-types src/add-app.ts",
    "app-access": "node dist/app-access.js",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.tools.json",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "eval": "npm run build && node dist/eval.js",
    "install-skill": "npm run build && node dist/install-skill.js",
    "uninstall-skill": "npm run build && node dist/install-skill.js --uninstall"
  },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0", "typescript": "^5.9.0",
    "@earendil-works/pi-ai": "0.86.1", "@earendil-works/pi-coding-agent": "0.86.1", "typebox": "^1.3.7"
  }
}
